{
  "name": "gpt-image-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "description": "Local-first AI image creation workbench. Chat-based interface for OpenAI-compatible Images API with mask editing, prompt modes, and multi-provider support.",
  "keywords": [
    "ai-image-generation",
    "openai",
    "gpt-image",
    "image-generation",
    "text-to-image",
    "image-editing",
    "vue",
    "vue3",
    "typescript",
    "local-first",
    "self-hosted",
    "ai-art",
    "open-source",
    "tauri",
    "docker"
  ],
  "homepage": "https://image.honlnk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honlnk/gpt-image-studio.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:companion": "pnpm --filter @honlnk/image-studio-companion dev",
    "build:sidecar": "pnpm --filter @honlnk/image-studio-companion build:sidecar",
    "dev:desktop": "pnpm build:sidecar && tauri dev",
    "build:desktop": "pnpm build:sidecar && tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:companion": "pnpm --filter @honlnk/image-studio-companion typecheck",
    "build": "vite-ssg build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
